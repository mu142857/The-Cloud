		"road_1": [
			{"say": "chen", "zh": "你对这里很熟？", "en": ""},
			{"say": "deer", "zh": "很熟。哪里有水，哪里有矿石，我都知道。", "en": ""},
			{"say": "chen", "zh": "那修飞船的人呢？", "en": ""},
			{"say": "deer", "zh": "弥洛。她住在树屋里。", "en": ""},
			{"say": "chen", "zh": "大象呢？长什么样？", "en": ""},
			{"say": "deer", "zh": "鼻子很长。", "en": ""},
			{"say": "chen", "zh": "对，就是长鼻子。", "en": "", "added": true},
			{"do": "journal", "zh": "鹿什么都知道：水、矿石、弥洛的树屋。它说大象的鼻子很长。", "en": "", "added": true},
			{"do": "anim", "who": "deer", "name": "ear"},
			{"do": "guide", "to": "deer_stall", "speed": 45},
			{"say": "deer", "zh": "这里以前卖吃的。", "en": ""},
